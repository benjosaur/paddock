# Database
# DATABASE_URL=postgresql://username:password@localhost:5432/paddock

# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Cognito 
COGNITO_USER_POOL_ID=eu-west-2_xyzxyzxyz
COGNITO_CLIENT_ID=xyz123
DEV_SUB=benjo
DEV_ROLE=Admin

DEPRIVATION_TABLE=DeprivationCompact
AWS_REGION=eu-west-2
DEPRIVATION_DYNAMO_ENDPOINT="http://localhost:8000"
DYNAMO_ENDPOINT="http://localhost:8000"

# Copilot (Bedrock). No local emulator — dev needs real AWS creds with Bedrock
# model access enabled. Keep the eu. prefix: it selects the EU-only geo
# inference profile, which is required for GDPR data residency.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# Client image attachments. Point local dev at the STAGING images bucket (the
# ImagesBucketName output of PaddockStack-Staging); presigning needs real AWS
# credentials (aws sso login), unlike DynamoDB Local above. Leave TABLE_NAME_*
# unset locally — local uploads then land under the WiveyCares2/ key prefix in
# that bucket, separate from staging's own WiveyCares2-Staging/ prefix. Unset
# IMAGES_BUCKET disables uploads with a clear error; the rest of the app works.
# IMAGES_BUCKET=paddock-images-staging-<account>-eu-west-2
