# Staging build config, loaded by `vite build --mode staging` on top of the
# gitignored base .env. These are public identifiers (they ship in the bundle),
# so this file is committed. Values come from the PaddockStack-Staging outputs:
#   cd infra && bun cdk deploy PaddockStack-Staging   (or: bun run deploy:staging)
# then copy UserPoolId, UserPoolClientId and the TrpcApi endpoint (+ /trpc) here.
VITE_STAGE=staging
VITE_API_URL=REPLACE_AFTER_FIRST_STAGING_DEPLOY
VITE_COGNITO_USER_POOL_ID=REPLACE_AFTER_FIRST_STAGING_DEPLOY
VITE_COGNITO_USER_POOL_CLIENT_ID=REPLACE_AFTER_FIRST_STAGING_DEPLOY
VITE_COGNITO_DOMAIN=paddock-staging.auth.eu-west-2.amazoncognito.com
